; Variable and immediate shifts. These cover every right-shift boundary
; relevant to the mask generator, including the former SMASK_HI failure.

; SLL
a 0x00:00000:001 0x00000001 0x00000000 ; 00000001
a 0x00:00000:001 0x00000001 0x00000001 ; 00000002
a 0x00:00000:001 0x00000001 0x0000001f ; 80000000
ai 0x00:00000:001 0x00000001 0x00000004 ; 00000010

; SRL: shifted-in bits must be zero, not rotated source bits.
a 0x00:00000:101 0x12345678 0x00000000 ; 12345678
a 0x00:00000:101 0x12345678 0x00000001 ; 091a2b3c
a 0x00:00000:101 0x12345678 0x00000004 ; 01234567
a 0x00:00000:101 0x80000001 0x0000001f ; 00000001
a 0x00:00000:101 0xffffffff 0x0000001f ; 00000001
ai 0x00:00000:101 0x12345678 0x00000004 ; 01234567
ai 0x00:00000:101 0x80000001 0x0000001f ; 00000001

; SRA: shifted-in bits reproduce the source sign bit.
a 0x20:00000:101 0x12345678 0x00000004 ; 01234567
a 0x20:00000:101 0x80000000 0x00000001 ; c0000000
a 0x20:00000:101 0x80000000 0x00000004 ; f8000000
a 0x20:00000:101 0x80000000 0x0000001f ; ffffffff
ai 0x20:00000:101 0x80000000 0x00000004 ; f8000000
