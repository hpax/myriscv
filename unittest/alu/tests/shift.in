; Variable and immediate shifts. These cover every right-shift boundary
; relevant to the mask generator, including the former SMASK_HI failure.

; SLL
a  0x00:00000:001 0x00000001 0x00000000 0x00000001
a  0x00:00000:001 0x00000001 0x00000001 0x00000002
a  0x00:00000:001 0x00000001 0x0000001f 0x80000000
ai 0x00:00000:001 0x00000001 0x00000004 0x00000010

; SRL: shifted-in bits must be zero, not rotated source bits.
a  0x00:00000:101 0x12345678 0x00000000 0x12345678
a  0x00:00000:101 0x12345678 0x00000001 0x091a2b3c
a  0x00:00000:101 0x12345678 0x00000004 0x01234567
a  0x00:00000:101 0x80000001 0x0000001f 0x00000001
a  0x00:00000:101 0xffffffff 0x0000001f 0x00000001
ai 0x00:00000:101 0x12345678 0x00000004 0x01234567
ai 0x00:00000:101 0x80000001 0x0000001f 0x00000001

; SRA: shifted-in bits reproduce the source sign bit.
a  0x20:00000:101 0x12345678 0x00000004 0x01234567
a  0x20:00000:101 0x80000000 0x00000001 0xc0000000
a  0x20:00000:101 0x80000000 0x00000004 0xf8000000
a  0x20:00000:101 0x80000000 0x0000001f 0xffffffff
ai 0x20:00000:101 0x80000000 0x00000004 0xf8000000
q
