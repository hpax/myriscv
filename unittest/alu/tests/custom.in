; Private custom ALU operations. rs2 supplies extract position or width.

; extru/extrs: funct7[4:0] is field width, funct7[5] selects sign extension.
x  0x08:00000:101 0x12345678 0x00000008 0x00000056 ; extru bits 8..15
x  0x28:00000:101 0x12345680 0x00000000 0xffffff80 ; extrs low byte
x  0x08:00000:101 0x12345678 0x00000010 0x00000034 ; extru bits 16..23

; zext/sext: rs2 supplies the extension width.
x  0x00:00000:111 0x12345678 0x00000008 0x00000078 ; zext 8
x  0x20:00000:111 0x12345680 0x00000008 0xffffff80 ; sext 8
x  0x00:00000:111 0x12345680 0x00000010 0x00005680 ; zext 16
x  0x20:00000:111 0x12345680 0x00000010 0x00005680 ; sext 16
q
