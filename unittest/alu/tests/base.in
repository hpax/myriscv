; type funct7:rs2:funct3 src1 src2 correct-result
; Expected result follows each vector in a comment.

; RV32I register arithmetic and comparisons
a  0x00:00000:000 0x12345678 0x11111111 0x23456789 ; add
a  0x20:00000:000 0x12345678 0x11111111 0x01234567 ; sub
a  0x00:00000:010 0xffffffff 0x00000001 0x00000001 ; slt
a  0x00:00000:010 0x00000001 0xffffffff 0x00000000 ; slt
a  0x00:00000:011 0xffffffff 0x00000001 0x00000000 ; sltu
a  0x00:00000:011 0x00000001 0xffffffff 0x00000001 ; sltu
a  0x00:00000:100 0x12345678 0x11111111 0x03254769 ; xor
a  0x00:00000:110 0x12345678 0x11111111 0x13355779 ; or
a  0x00:00000:111 0x12345678 0x11111111 0x10101010 ; and

; RV32I immediate arithmetic and comparisons
ai 0x00:00000:000 0x12345678 0xffffffff 0x12345677 ; addi  -1
ai 0x00:00000:010 0x12345678 0x00000001 0x00000000 ; slti   1
ai 0x00:00000:010 0xffffffff 0x00000001 0x00000001 ; slti   1
ai 0x00:00000:011 0xfffffffe 0xffffffff 0x00000001 ; sltiu -1
ai 0x00:00000:100 0x12345678 0xffffffff 0xedcba987 ; xori  -1
ai 0x00:00000:110 0x12345600 0x00000055 0x12345655 ; ori   55
ai 0x00:00000:111 0x12345678 0x000005a5 0x00000420 ; andi 5a5
q
