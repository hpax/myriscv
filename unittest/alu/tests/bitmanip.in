; Zba, Zbb, Zbs, and Zicond ALU vectors enabled by the default configuration.

; Zba
a 0x10:00000:010 0x00000003 0x0000000a ; sh1add = 00000010
a 0x10:00000:100 0x00000003 0x0000000a ; sh2add = 00000016
a 0x10:00000:110 0x00000003 0x0000000a ; sh3add = 00000022
a 0x30:00000:010 0x0000000a 0x00000003 ; sh1sub = 00000011
a 0x30:00000:100 0x0000000a 0x00000003 ; sh2sub = 00000025
a 0x30:00000:110 0x0000000a 0x00000003 ; sh3sub = 0000004d

; Zbb logical, min/max, rotate, byte operations, and bit counts
a 0x20:00000:111 0x0000f0f0 0x00000ff0 ; andn = 0000f000
a 0x20:00000:110 0x0000f0f0 0x00000ff0 ; orn  = fffff0ff
a 0x20:00000:100 0x0000f0f0 0x00000ff0 ; xnor = ffff00ff
a 0x05:00000:100 0xffffffff 0x00000001 ; min  = ffffffff
a 0x05:00000:101 0xffffffff 0x00000001 ; max  = 00000001
a 0x05:00000:110 0xffffffff 0x00000001 ; minu = 00000001
a 0x05:00000:111 0xffffffff 0x00000001 ; maxu = ffffffff
a 0x30:00000:001 0x80000001 0x00000001 ; rol  = 00000003
a 0x30:00000:101 0x00000003 0x00000001 ; ror  = 80000001
ai 0x30:00000:001 0x00000010 0x00000000 ; clz  = 0000001b
ai 0x30:00001:001 0x00000010 0x00000000 ; ctz  = 00000004
ai 0x30:00010:001 0xf0f0f0f0 0x00000000 ; cpop = 00000010
ai 0x30:00100:001 0x00000080 0x00000000 ; sext.b = ffffff80
ai 0x30:00101:001 0x00008000 0x00000000 ; sext.h = ffff8000
a 0x04:00000:100 0xffff8000 0x00000000 ; zext.h = 00008000

; Zbs
a 0x14:00000:001 0x00000000 0x0000001f ; bset = 80000000
a 0x24:00000:001 0xffffffff 0x0000001f ; bclr = 7fffffff
a 0x34:00000:001 0x00000000 0x00000004 ; binv = 00000010
a 0x24:00000:101 0x00000010 0x00000004 ; bext = 00000001

; Zicond
a 0x07:00000:101 0x12345678 0x00000000 ; czero.eqz = 12345678
a 0x07:00000:101 0x12345678 0x00000001 ; czero.eqz = 00000000
a 0x07:00000:111 0x12345678 0x00000000 ; czero.nez = 00000000
a 0x07:00000:111 0x12345678 0x00000001 ; czero.nez = 12345678
