# -*- tcl -*-
#
# This file contains no real content, so when Quartus messes it up it
# can just be reset. The only real line is:
#   set_global_assignment -name SOURCE_TCL_SCRIPT_FILE myriscv.qsf
#
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE myriscv.qsf
set_global_assignment -name TOP_LEVEL_ENTITY benchmark

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top